GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_API_KEY=your-gemini-api-key

HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*
# Set to require a token (entered in the UI under Settings -> Access token)
ACCESS_TOKEN=

# Models (override if Google renames them)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_AGENT_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite

SESSION_TTL_SECONDS=3600
MAX_SESSIONS=10

SCREENSHOT_INTERVAL_MS=2000
MAX_IMAGE_SIZE_PX=1280

BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=10000
# BROWSER_EXECUTABLE_PATH=/path/to/chromium
# Let ARIA's browser open localhost / private IPs (keep false when deployed)
ALLOW_PRIVATE_NETWORK=false
